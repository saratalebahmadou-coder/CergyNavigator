@startuml

title __GUI's Class Diagram__\n

  namespace GUI {
    class GUI.GUI {
        ~ alive : boolean
        ~ jPanelNorth : JPanel
        ~ jPanelSouth : JPanel
        + GUI()
        - blinkAlive()
        - drawGUI()
        - refresh()
    }
  }
  

  namespace GUI {
    class GUI.Indicator {
        - value : boolean
        + getPreferredSize()
        + paintComponent()
        + setValue()
    }
  }
  

  namespace GUI {
    class GUI.SNCFStyleDisplay {
        - height : int
        - information : ArrayList<String>
        - numberOfTrain : int
        - width : int
        + SNCFStyleDisplay()
        + getPreferredSize()
        + paintComponent()
        + refresh()
    }
  }
  

  GUI.GUI -up-|> javax.swing.JFrame
  GUI.GUI o-- GUI.Indicator : indicatorAlive
  GUI.GUI o-- GUI.SNCFStyleDisplay : sncfStyleDisplay
  GUI.Indicator -up-|> javax.swing.JComponent
  GUI.SNCFStyleDisplay -up-|> javax.swing.JComponent
  GUI.SNCFStyleDisplay o-- STIFAPI.STIFAPIRequest : stifapiRequest


